    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.58.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ]

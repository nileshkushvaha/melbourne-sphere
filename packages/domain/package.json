{
  "name": "@melbourne-sphere/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Domain rules shared by the API and the worker (SRS ARC 002: share the service, never copy the invariant).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },

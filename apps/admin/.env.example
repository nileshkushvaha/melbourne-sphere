# Copy to apps/admin/.env for local overrides (git-ignored). Read ONLY by
# vite.config.ts on the server side (dev server / preview); nothing here reaches
# the browser bundle. The browser always calls relative /api/v1 URLs.
#
# Origin of the NestJS API that the development proxy forwards /api/v1 to.
# Default shown. In production the reverse proxy routes /api/v1 itself.
ADMIN_API_PROXY_TARGET=http://127.0.0.1:3001
